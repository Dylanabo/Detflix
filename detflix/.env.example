# Copie ce fichier en .env.local puis remplis les valeurs.

# Connexion PostgreSQL (correspond à docker-compose.yml)
DATABASE_URL=postgres://detflix:detflix@localhost:5432/detflix

# NextAuth : génère un secret avec `openssl rand -base64 32`
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Optionnel : compte créé par `npm run db:seed` (jamais versionné)
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
